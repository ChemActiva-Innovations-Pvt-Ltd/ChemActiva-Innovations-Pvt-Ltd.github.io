{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": "warn",
    "no-console": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "*.min.js",
    "vendor.*.js",
    "*.CmOfqZsh.js",
    "*.BgEkQAtb.js",
    "*.XXBai8XY.js",
    "*.wYy8LG9Z.js",
    "*.jD3-7TUA.js",
    "*.CPcilrEE.js",
    "*.CqjTI3bh.js",
    "*.D26ZPjJ_.js",
    "*.CdQ_VlLu.js",
    "*.BtrVqNFs.js",
    "*.BWOQ4zFL.js",
    "*.BvIaTjIT.js"
  ]
}
