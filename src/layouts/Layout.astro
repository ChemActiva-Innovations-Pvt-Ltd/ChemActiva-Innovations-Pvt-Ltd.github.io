---
import '../styles/base.css';
import '../styles/theme.css';
import '../styles/typography.css';
import '../styles/navbar.css';
// Import other global CSS if needed, or import in specific pages

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title || "ChemActiva – Pioneering Sustainable Nano Cellulose"}</title>
	<meta name="description" content={description || "ChemActiva Innovations is a deep-tech startup producing sustainable Nano Cellulose, Bio-based Oil Spill Kits, and Green Technologies for a cleaner future."}>
	<meta name="keywords" content="Nano Cellulose, Crystalline Nano Cellulose, CNC, Oil Spill Kits, Sustainable Chemicals, Green Technology, Biodegradable Polymers, ChemActiva, Bio-economy">
	<meta name="author" content="ChemActiva Innovations Pvt. Ltd.">
	<meta name="robots" content="index, follow">

	<!-- Open Graph / Facebook -->
	<meta property="og:type" content="website">
	<meta property="og:url" content="https://chemactiva.com/">
	<meta property="og:title" content={title || "ChemActiva – Pioneering Sustainable Nano Cellulose"}>
	<meta property="og:description" content={description || "ChemActiva Innovations is a deep-tech startup producing sustainable Nano Cellulose."}>
	<meta property="og:image" content="/assets/images/logo.png">

	<!-- Twitter -->
	<meta property="twitter:card" content="summary_large_image">
	<meta property="twitter:url" content="https://chemactiva.com/">
	<meta property="twitter:title" content={title || "ChemActiva – Pioneering Sustainable Nano Cellulose"}>
	<meta property="twitter:description" content={description || "ChemActiva Innovations is a deep-tech startup."}>
	<meta property="twitter:image" content="/assets/images/logo.png">
    
    <link rel="icon" type="image/x-icon" href="/favicon.svg">
</head>
<body class="homepage">
	<div id="hero-loader">
		<div id="loader-background"></div>
		<div id="loader-content"> <!-- Particle animation will be injected here by JS --> </div>
	</div>
	<div id="main-container">
		<header id="navbar">
			<div class="container"> <a href="/" class="logo"> <img src="/assets/images/logo.png" alt="ChemActiva Logo" id="navbar-logo-img"> </a>
				<nav class="nav-links"> 
                    <a href="/#about-us">About</a> 
                    <a href="/#our-journey">Journey</a> 
                    <a href="/products">Products</a> 
                    <a href="/#innovation">Innovation</a> 
                    <a href="/blog">Blog</a> 
                    <a href="/#our-team">Team</a> 
                    <a href="/#contact">Contact</a>
					<div class="theme-switcher theme-switcher-mobile"> 
                        <input type="checkbox" id="theme-toggle-mobile" class="theme-toggle-checkbox"> 
                        <label for="theme-toggle-mobile" class="theme-toggle-label">
							<span class="toggle-ball"> <span class="icon sun-icon">☀️</span> <span class="icon moon-icon">🌙</span> </span> 
                        </label> 
                    </div>
				</nav>
				<div class="controls-container">
					<div class="theme-switcher" id="theme-switcher-desktop"> 
                        <input type="checkbox" id="theme-toggle" class="theme-toggle-checkbox"> 
                        <label for="theme-toggle" class="theme-toggle-label"> 
                            <span class="toggle-ball"> <span class="icon sun-icon">☀️</span> <span class="icon moon-icon">🌙</span> </span> 
                        </label> 
                    </div> 
                    <button id="hamburger-menu" aria-label="Open menu"> <span></span> <span></span> <span></span> </button>
				</div>
			</div>
		</header>
		<main>
            <slot />
		</main>
		<footer id="footer">
			<div class="container">
				<p>© <span id="current-year"></span> ChemActiva Innovations Pvt Ltd. All rights reserved.</p>
				<p>Pioneering Sustainable Nano Cellulose</p>
			</div>
		</footer>
	</div>

    <!-- Global Scripts -->
	<script type="module" src="/js/main.js" is:inline></script>
	<script src="/js/sw-register.js" is:inline></script>
	<script type="module" src="/js/mobile-enhancements.js" is:inline></script>
	<script type="module" src="/js/visual-enhancements.js" is:inline></script>
	<script src="/js/lazy-loading.js" is:inline></script>
</body>
</html>
