---
/**
 * ChemActiva Blog Index
 * Authored by Shuvam Banerji Seal
 */
import '../../styles/modern-design.css';

const title = "Blog - ChemActiva Innovations";
const description = "Insights and stories from sustainable nanocellulose technology.";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="leaves-container" id="leaves-container"></div>

    <nav class="modern-navbar">
        <div class="container nav-container">
            <a href="/" class="nav-logo"><img src="/assets/images/logo.png" alt="ChemActiva"></a>
            <div class="nav-links-modern" id="nav-menu">
                <a href="/#our-journey">Journey</a>
                <a href="/#innovation">Innovation</a>
                <a href="/products">Products</a>
                <a href="/blog" style="color: var(--accent-secondary);">Blog</a>
                <a href="/team">Team</a>
                <a href="/#contact">Contact</a>
                <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle dark/light theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg></button>
            </div>
            <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
        </div>
    </nav>

    <main style="padding-top: 100px;">
        <section style="padding: 2rem 0; text-align: center;">
            <div class="container">
                <h1>Our <span class="text-gradient">Blog</span></h1>
                <p style="color: var(--text-secondary); max-width: 500px; margin: 0 auto;">Insights from sustainable nanocellulose technology.</p>
            </div>
        </section>

        <section style="padding: 2rem 0 var(--section-padding);">
            <div class="container">
                <div class="blog-toolbar" id="blog-toolbar" style="display:none;">
                    <button class="blog-filter-chip active" data-tag="all" aria-pressed="true">All Posts</button>
                    <!-- tag chips injected by JS -->
                    <input type="search" class="blog-search form-group" id="blog-search" placeholder="Search articles…" aria-label="Search articles">
                </div>
                <div class="blog-grid" id="blog-grid" aria-busy="true"><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div></div>
                <p class="blog-empty" id="blog-empty" hidden>No articles match your search.</p>
            </div>
        </section>
        
        <footer class="footer-modern">
            <div class="container">
                <div class="footer-grid">
                    <div class="footer-brand">
                        <h3>ChemActiva Innovations</h3>
                        <p>Pioneering sustainable nano cellulose from the indigenous shola plant. Deep-tech startup incubated at RISE Foundation IISER, IISER Kolkata.</p>
                    </div>
                    <div class="footer-col">
                        <h4>Explore</h4>
                        <a href="/#our-journey">Our Journey</a>
                        <a href="/products">Products</a>
                        <a href="/blog">Blog</a>
                        <a href="/team">Team</a>
                    </div>
                    <div class="footer-col">
                        <h4>Contact</h4>
                        <a href="mailto:chemactiva.innovations@gmail.com">chemactiva.innovations@gmail.com</a>
                        <a href="tel:+919830117780">+91 983 011 7780</a>
                        <a href="https://www.linkedin.com/company/104465867/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                        <a href="/#contact">RISE Foundation IISER, Kolkata</a>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p>&copy; <span id="current-year"></span> ChemActiva Innovations Pvt Ltd. All rights reserved.</p>
                    <p>Pioneering Sustainable Nano Cellulose</p>
                </div>
            </div>
        </footer>
    </main>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', async () => {
            // Leaves (animated SVG, not emojis)
            const leavesContainer = document.getElementById('leaves-container');
            const LEAF_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21C7 16.5 4 13 4 9.5 4 6 6.5 3.5 10 3.5c1 0 2 .25 2 .25S13.5 3 15 3.5 20 6 20 9.5c0 3.5-3 7-8 11.5z" opacity="0.9"/><path d="M12 21c0-6 .5-10 3-14" opacity="0.5" stroke-width="1"/></svg>';
            for (let i = 0; i < 10; i++) {
                const leaf = document.createElement('div');
                leaf.className = 'leaf-svg';
                leaf.setAttribute('aria-hidden', 'true');
                leaf.innerHTML = LEAF_SVG;
                leaf.style.left = Math.random() * 100 + '%';
                leaf.style.animationDelay = -(Math.random() * 14) + 's';
                leaf.style.animationDuration = (10 + Math.random() * 8) + 's';
                leaf.style.width = leaf.style.height = (18 + Math.random() * 18) + 'px';
                leavesContainer.appendChild(leaf);
            }

            // Hamburger
            const hamburger = document.getElementById('hamburger');
            const navMenu = document.getElementById('nav-menu');
            hamburger.addEventListener('click', () => { hamburger.classList.toggle('active'); navMenu.classList.toggle('active'); });
            navMenu.querySelectorAll('a').forEach(l => l.addEventListener('click', () => { hamburger.classList.remove('active'); navMenu.classList.remove('active'); }));

            // Theme
            const themeBtn = document.getElementById('theme-toggle');
            if (localStorage.getItem('theme') === 'light') { document.body.classList.add('light-mode'); themeBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>'; }
            themeBtn.addEventListener('click', () => { document.body.classList.toggle('light-mode'); const isLight = document.body.classList.contains('light-mode'); themeBtn.innerHTML = isLight ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>' : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>'; themeBtn.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme'); localStorage.setItem('theme', isLight ? 'light' : 'dark'); });

            document.getElementById('current-year').textContent = new Date().getFullYear();
            // Nav active state
            (function markActiveNav() {
                const path = location.pathname;
                document.querySelectorAll('#nav-menu a').forEach(a => {
                    const href = a.getAttribute('href') || '';
                    const isAnchor = href.startsWith('#') || href.startsWith('/#');
                    const target = isAnchor ? '/' : (href.replace(/\/$/, '') || '/');
                    if (path.replace(/\/$/, '') === target) a.setAttribute('aria-current', 'page');
                });
            })();

            // Scroll-to-top
            const scrollBtn = document.getElementById('scroll-top');
            window.addEventListener('scroll', () => {
                scrollBtn.classList.toggle('visible', window.scrollY > 600);
            }, { passive: true });
            scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

            // Load Blogs + tag filter + search
            try {
                const res = await fetch('/blog.jsonl');
                const text = await res.text();
                const blogs = text.trim().split('\n').map(JSON.parse).sort((a, b) => new Date(b.date) - new Date(a.date));

                const grid = document.getElementById('blog-grid');
                const toolbar = document.getElementById('blog-toolbar');
                const emptyMsg = document.getElementById('blog-empty');
                const searchInput = document.getElementById('blog-search');

                // Tag chips (from data)
                const allTags = [...new Set(blogs.flatMap(b => b.tags || []))];
                const chipWrap = document.getElementById('blog-toolbar');
                allTags.forEach(tag => {
                    const chip = document.createElement('button');
                    chip.className = 'blog-filter-chip';
                    chip.dataset.tag = tag;
                    chip.setAttribute('aria-pressed', 'false');
                    chip.textContent = tag;
                    chipWrap.insertBefore(chip, searchInput);
                });

                let activeTag = 'all';
                let query = '';

                function cardHTML(blog, bi) {
                    const words = (blog.abstract || '').split(/\s+/).length;
                    const readMin = Math.max(2, Math.round(words / 200));
                    return `
                    <article class="glass-card blog-card reveal" style="--reveal-delay: ${(bi % 3) * 0.1}s" role="link" tabindex="0" aria-label="Read article: ${blog.title}" onclick="window.location.href='/blog/post/${blog.id}'" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.location.href='/blog/post/${blog.id}'}">
                        <div class="blog-cover"><img src="${blog.coverImage}" alt="${blog.title}" loading="lazy" decoding="async"></div>
                        <div class="blog-meta">
                            <span class="meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>${new Date(blog.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                            <span class="meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>${blog.author}</span>
                            <span class="meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>${readMin} min read</span>
                        </div>
                        <h3 style="margin-bottom: 0.4rem;">${blog.title}</h3>
                        <p style="font-size: 0.85rem; line-height: 1.5;">${blog.abstract.length > 120 ? blog.abstract.substring(0, 120) + '...' : blog.abstract}</p>
                        <div class="blog-tags">${blog.tags.slice(0, 3).map(t => `<span class="blog-tag">${t}</span>`).join('')}</div>
                    </article>`;
                }

                function render() {
                    const q = query.toLowerCase();
                    const visible = blogs.filter(b =>
                        (activeTag === 'all' || (b.tags || []).includes(activeTag)) &&
                        (!q || b.title.toLowerCase().includes(q) || (b.abstract || '').toLowerCase().includes(q) || (b.tags || []).join(' ').toLowerCase().includes(q))
                    );
                    grid.setAttribute('aria-busy', 'false');
                    grid.innerHTML = visible.length
                        ? visible.map((b, bi) => cardHTML(b, bi)).join('')
                        : '';
                    emptyMsg.hidden = visible.length > 0;

                    // Reveal newly rendered cards
                    const cards = grid.querySelectorAll('.blog-card.reveal');
                    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                        const bio = new IntersectionObserver((entries) => {
                            entries.forEach(en => {
                                if (en.isIntersecting) { en.target.classList.add('revealed'); bio.unobserve(en.target); }
                            });
                        }, { threshold: 0.1 });
                        cards.forEach(c => bio.observe(c));
                    } else {
                        cards.forEach(c => c.classList.add('revealed'));
                    }
                }

                toolbar.addEventListener('click', (e) => {
                    const chip = e.target.closest('.blog-filter-chip');
                    if (!chip) return;
                    toolbar.querySelectorAll('.blog-filter-chip').forEach(c => {
                        c.classList.remove('active');
                        c.setAttribute('aria-pressed', 'false');
                    });
                    chip.classList.add('active');
                    chip.setAttribute('aria-pressed', 'true');
                    activeTag = chip.dataset.tag;
                    render();
                });

                searchInput.addEventListener('input', (e) => {
                    query = e.target.value.trim();
                    render();
                });

                toolbar.style.display = 'flex';
                render();
            } catch (e) {
                document.getElementById('blog-grid').innerHTML = '<p>Error loading posts.</p>';
            }
        });
    </script>
    <script is:inline>
    // Service Worker registration (PWA)
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch((e) => console.warn('SW registration failed:', e));
        });
    }
    </script>
<button class="scroll-top-btn" id="scroll-top" aria-label="Scroll back to top">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        </button>
</body>
</html>
