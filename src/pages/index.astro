---
/**
 * ChemActiva Homepage
 * Authored by Shuvam Banerji Seal
 */
import '../styles/modern-design.css';

const title = "ChemActiva Innovations - Sustainable Nanocellulose & Green Technology";
const description = "ChemActiva Innovations pioneers sustainable Nano Cellulose, Oil Spill Kits, and Green Technologies.";
const siteUrl = "https://chemactiva.com";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content="nanocellulose, green technology, sustainable chemicals, oil spill kit, ChemActiva">
    <meta name="author" content="Shuvam Banerji Seal, ChemActiva Innovations Pvt Ltd">
    <link rel="canonical" href={siteUrl}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={siteUrl}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={`${siteUrl}/assets/images/covers/group-portrait.webp`}>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0a1208">
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "ChemActiva Innovations Pvt Ltd",
        "url": "https://chemactiva.com",
        "logo": "https://chemactiva.com/assets/images/logo.png"
    }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="image" href="/assets/images/slides/slide-panel-cnc.webp" fetchpriority="high">
    <link rel="preload" as="image" href="/assets/images/slides/slide-nanocellulose.webp" fetchpriority="high">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="leaves-container" id="leaves-container"></div>

    <!-- Slideshow Modal -->
    <div class="slideshow-modal" id="slideshow-modal">
        <div class="slideshow-container">
            <button class="slideshow-close" id="slideshow-close">&times;</button>
            <img class="slideshow-image" id="slideshow-image" src="" alt="">
            <div class="slideshow-caption" id="slideshow-caption"></div>
            <button class="slideshow-nav slideshow-prev" id="slideshow-prev">❮</button>
            <button class="slideshow-nav slideshow-next" id="slideshow-next">❯</button>
            <div class="slideshow-dots" id="slideshow-dots"></div>
        </div>
    </div>

    <nav class="modern-navbar">
        <div class="container nav-container">
            <a href="/" class="nav-logo"><img src="/assets/images/logo.png" alt="ChemActiva"></a>
            <div class="nav-links-modern" id="nav-menu">
                <a href="#our-journey">Journey</a>
                <a href="#innovation">Innovation</a>
                <a href="/products">Products</a>
                <a href="/blog">Blog</a>
                <a href="#team">Team</a>
                <a href="#contact">Contact</a>
                <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle dark/light theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg></button>
            </div>
            <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
        </div>
    </nav>

    <main>
        <section class="hero-modern">
            <div class="hero-bg-glow glow-top-right"></div>
            <div class="hero-bg-glow glow-bottom-left"></div>
            <div class="container hero-grid-modern">
                <div class="hero-text-content">
                    <h1>Pioneering <span class="text-gradient" id="typewriter" aria-live="polite"></span><br>for a Cleaner Future</h1>
                    <p class="hero-description">ChemActiva harnesses green technology and the indigenous shola plant to transform renewable biomass into advanced, sustainable biomaterials.</p>
                    <div class="hero-buttons">
                        <a href="/products" class="btn-modern">Explore Solutions</a>
                        <a href="#contact" class="btn-outline">Get in Touch</a>
                    </div>
                </div>
                <div class="hero-visual-modern" id="hero-visual" role="button" tabindex="0" aria-label="Open image slideshow">
                    <div class="hero-image-stack" id="hero-stack"></div>
                    <div class="click-hint">Click to view slideshow</div>
                </div>
            </div>
        </section>

        <section id="our-journey" class="reveal" style="padding: var(--section-padding);">
            <div class="container">
                <h2>Our <span class="text-gradient">Journey</span></h2>
                <div class="timeline-container" id="journey-container" aria-busy="true"><div class="skeleton skeleton-line"></div><div class="skeleton skeleton-line" style="width:80%"></div><div class="skeleton skeleton-line" style="width:60%"></div></div>
            </div>
        </section>

        <section id="innovation" class="features-modern reveal">
            <div class="container">
                <h2>Our <span class="text-gradient">Core Innovations</span></h2>
                <p style="color: var(--text-secondary); max-width: 720px; margin: 0 auto 2rem; text-align: center; line-height: 1.7;">
                    ChemActiva valorizes the indigenous, non-edible shola plant (<em>Aeschynomene aspera</em> L.) —
                    abundantly grown in the marshy waterlands of Bengal — into high-value, sustainable biomaterials
                    that replace hazardous and non-biodegradable alternatives.
                </p>
                <div class="grid-3">
                    <article class="glass-card reveal reveal-scale" style="--reveal-delay: 0s"><div class="feature-icon-svg" aria-hidden="true"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21C7 16.5 4 13 4 9.5 4 6 6.5 3.5 10 3.5c1 0 2 .25 2 .25S13.5 3 15 3.5 20 6 20 9.5c0 3.5-3 7-8 11.5z" opacity="0.9"/><path d="M12 21c0-6 .5-10 3-14" opacity="0.5" stroke-width="1"/></svg></div><h3>Sustainable Chemicals</h3><p>Low-bulk-density nanocellulose from renewable shola biomass.</p></article>
                    <article class="glass-card reveal reveal-scale" style="--reveal-delay: 0.12s"><div class="feature-icon-svg" aria-hidden="true"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18h8"/><path d="M9 14l6-9 3.5 2.3-6 9z"/><path d="M8.5 13.5L11 15"/><path d="M5 18c0-1 .8-2 2-2h6c1.2 0 2 1 2 2v2H5z"/><circle cx="17.5" cy="6.5" r="1"/></svg></div><h3>Lab Solutions</h3><p>Cellulose-based microscope immersion oil cleaning kits for optical-grade lens care.</p></article>
                    <article class="glass-card reveal reveal-scale" style="--reveal-delay: 0.24s"><div class="feature-icon-svg" aria-hidden="true"><svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12c2-2.5 4-2.5 6 0s4 2.5 6 0 4-2.5 6 0"/><path d="M2 17c2-2.5 4-2.5 6 0s4 2.5 6 0 4-2.5 6 0"/><path d="M2 7c2-2.5 4-2.5 6 0s4 2.5 6 0 4-2.5 6 0" opacity="0.5"/></svg></div><h3>Oil Spill Response</h3><p>Reusable, high-absorption kits for marine, industrial and coastal cleanup.</p></article>
                </div>
            </div>
        </section>

        <section id="products" class="reveal" style="padding: var(--section-padding);">
            <div class="container">
                <h2>Our <span class="text-gradient">Products</span></h2>
                <div class="products-showcase-grid" id="products-container"></div>
                <div style="text-align: center; margin-top: 1.5rem;"><a href="/products" class="btn-modern">View All Products</a></div>
            </div>
        </section>

        <section id="team" class="reveal" style="padding: var(--section-padding);">
            <div class="container">
                <h2>Meet the <span class="text-gradient">Team</span></h2>
                <div class="team-grid-modern" id="team-container" aria-busy="true"><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div></div>
            </div>
        </section>

        <section id="advisors" class="reveal" style="padding: var(--section-padding); background: var(--bg-medium);">
            <div class="container">
                <h2>Our <span class="text-gradient">Advisors</span></h2>
                <div class="advisors-grid" id="advisors-container" aria-busy="true"><div class="skeleton skeleton-circle"></div><div class="skeleton skeleton-circle"></div></div>
            </div>
        </section>

        <section id="contact" class="contact-section reveal">
            <div class="container">
                <h2>Get in <span class="text-gradient">Touch</span></h2>
                <div class="contact-grid">
                    <div class="contact-info glass-card">
                        <h3>ChemActiva Innovations Pvt Ltd</h3>
                        <p>RISE Foundation IISER, Mohanpur, Nadia – 741246, West Bengal</p>
                        <p><strong>Email:</strong> <a href="mailto:chemactiva.innovations@gmail.com">chemactiva.innovations@gmail.com</a></p>
                        <p><strong>Phone:</strong> <a href="tel:+919830117780">+91 983 011 7780</a></p>
                    </div>
                    <form class="contact-form glass-card" id="contact-form">
                        <div class="form-group"><input type="text" name="name" placeholder="Your Name" aria-label="Your name" required></div>
                        <div class="form-group"><input type="email" name="email" placeholder="Your Email" aria-label="Your email address" required></div>
                        <div class="form-group"><input type="text" name="subject" placeholder="Subject" aria-label="Message subject" required></div>
                        <div class="form-group"><textarea name="message" placeholder="Your Message" aria-label="Your message" required></textarea></div>
                        <button type="submit" class="btn-modern">Send Message</button>
                        <p id="contact-status" role="status" aria-live="polite" style="font-size: 0.85rem; margin-top: 0.75rem; text-align: center; min-height: 1.2em;"></p>
                    </form>
                </div>
            </div>
        </section>
        
        <footer class="footer-modern">
            <div class="container">
                <div class="footer-grid">
                    <div class="footer-brand">
                        <h3>ChemActiva Innovations</h3>
                        <p>Pioneering sustainable nano cellulose from the indigenous shola plant. Deep-tech startup incubated at RISE Foundation IISER, IISER Kolkata.</p>
                    </div>
                    <div class="footer-col">
                        <h4>Explore</h4>
                        <a href="/#our-journey">Our Journey</a>
                        <a href="/products">Products</a>
                        <a href="/blog">Blog</a>
                        <a href="/#team">Team</a>
                    </div>
                    <div class="footer-col">
                        <h4>Contact</h4>
                        <a href="mailto:chemactiva.innovations@gmail.com">chemactiva.innovations@gmail.com</a>
                        <a href="tel:+919830117780">+91 983 011 7780</a>
                        <a href="https://www.linkedin.com/company/104465867/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                        <a href="/#contact">RISE Foundation IISER, Kolkata</a>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p>&copy; <span id="current-year">2026</span> ChemActiva Innovations Pvt Ltd. All rights reserved.</p>
                    <p>Pioneering Sustainable Nano Cellulose</p>
                </div>
            </div>
        </footer>

        <button class="scroll-top-btn" id="scroll-top" aria-label="Scroll back to top">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        </button>
    </main>

    <script is:inline>
        /**
         * Authored by Shuvam Banerji Seal
         */
        document.addEventListener('DOMContentLoaded', () => {
            // Leaves (animated SVG, not emojis)
            const leavesContainer = document.getElementById('leaves-container');
            const LEAF_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21C7 16.5 4 13 4 9.5 4 6 6.5 3.5 10 3.5c1 0 2 .25 2 .25S13.5 3 15 3.5 20 6 20 9.5c0 3.5-3 7-8 11.5z" opacity="0.9"/><path d="M12 21c0-6 .5-10 3-14" opacity="0.5" stroke-width="1"/></svg>`;
            for (let i = 0; i < 12; i++) {
                const leaf = document.createElement('div');
                leaf.className = 'leaf-svg';
                leaf.setAttribute('aria-hidden', 'true');
                leaf.innerHTML = LEAF_SVG;
                leaf.style.left = Math.random() * 100 + '%';
                leaf.style.animationDelay = -(Math.random() * 14) + 's';
                leaf.style.animationDuration = (10 + Math.random() * 8) + 's';
                leaf.style.width = leaf.style.height = (18 + Math.random() * 18) + 'px';
                leavesContainer.appendChild(leaf);
            }

            // Hamburger (with scroll lock + Escape to close)
            const hamburger = document.getElementById('hamburger');
            const navMenu = document.getElementById('nav-menu');
            function closeNav() {
                hamburger.classList.remove('active');
                navMenu.classList.remove('active');
                document.body.classList.remove('nav-open');
            }
            hamburger.addEventListener('click', () => {
                const opening = !navMenu.classList.contains('active');
                hamburger.classList.toggle('active', opening);
                navMenu.classList.toggle('active', opening);
                document.body.classList.toggle('nav-open', opening);
            });
            navMenu.querySelectorAll('a').forEach(link => link.addEventListener('click', closeNav));
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeNav(); });

            // Theme
            const themeBtn = document.getElementById('theme-toggle');
            if (localStorage.getItem('theme') === 'light') { document.body.classList.add('light-mode'); themeBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>'; }
            themeBtn.addEventListener('click', () => { document.body.classList.toggle('light-mode'); const isLight = document.body.classList.contains('light-mode'); themeBtn.innerHTML = isLight ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>' : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>'; themeBtn.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme'); localStorage.setItem('theme', isLight ? 'light' : 'dark'); });

            document.getElementById('current-year').textContent = new Date().getFullYear();

            // Nav active state (aria-current for a11y + styling)
            (function markActiveNav() {
                const path = location.pathname;
                document.querySelectorAll('#nav-menu a').forEach(a => {
                    const href = a.getAttribute('href') || '';
                    const isAnchor = href.startsWith('#') || href.startsWith('/#');
                    const target = isAnchor ? '/' : (href.replace(/\/$/, '') || '/');
                    const current = path.replace(/\/$/, '') === target;
                    if (current) a.setAttribute('aria-current', 'page');
                });
            })();

            // Scroll-to-top
            const scrollBtn = document.getElementById('scroll-top');
            window.addEventListener('scroll', () => {
                scrollBtn.classList.toggle('visible', window.scrollY > 600);
            }, { passive: true });
            scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

            // Typewriter
            const textEl = document.getElementById('typewriter');
            const phrases = ["Green Technology", "Nano Cellulose", "Sustainable Solutions"];
            let pi = 0, ci = 0, del = false;
            function type() {
                const p = phrases[pi];
                textEl.textContent = p.substring(0, del ? --ci : ++ci);
                textEl.classList.add('typewriter-text');
                if (!del && ci === p.length) { del = true; setTimeout(type, 1500); }
                else if (del && ci === 0) { del = false; pi = (pi + 1) % phrases.length; setTimeout(type, 300); }
                else setTimeout(type, del ? 40 : 70);
            }
            type();

            // Hero Images & Slideshow — MILESTONES FIRST, then products.
            // Each image keeps its natural aspect ratio (no cropping).
            const heroImages = [
                { img: '/assets/images/slides/slide-panel-hdfc.webp', text: 'HDFC Parivartan Grant', cat: 'Milestone' },
                { img: '/assets/images/slides/slide-panel-dst.webp', text: 'DST NIDHI PRAYAS Award', cat: 'Milestone' },
                { img: '/assets/images/slides/slide-panel-blue-economy.webp', text: 'Blue Economy Award', cat: 'Milestone' },
                { img: '/assets/images/slides/slide-panel-cnc.webp', text: 'Crystalline Nano Cellulose', cat: 'Product' },
                { img: '/assets/images/slides/slide-nanocellulose.webp', text: 'Low-Bulk-Density Nanocellulose', cat: 'Product' },
                { img: '/assets/images/slides/slide-microscope-kit.webp', text: 'Microscope Immersion Oil Cleaning Kit', cat: 'Product' },
                { img: '/assets/images/slides/slide-panel-oil-spill.webp', text: 'Advanced Oil Spill Kits', cat: 'Product' },
                { img: '/assets/images/slides/slide-marine-kit.webp', text: 'Marine & Industrial Oil Spill Kit', cat: 'Product' },
                { img: '/assets/images/slides/slide-domestic-kit.webp', text: 'Domestic Oil Spill Kit', cat: 'Product' },
                { img: '/assets/images/slides/slide-greenulose-packaging.webp', text: 'Greenulose™ Packaging', cat: 'Product' }
            ];
            const heroStack = document.getElementById('hero-stack');
            let heroIdx = 0;

            // Build one card per slide: blurred-fill backdrop + full-size image,
            // category badge + caption. Image always renders at maximum size.
            heroImages.forEach((data, i) => {
                const div = document.createElement('div');
                div.className = 'hero-stack-image';
                div.dataset.cat = data.cat;
                div.innerHTML = `
                    <div class="hero-slide-bg" style="background-image: url('${data.img}')" aria-hidden="true"></div>
                    <img src="${data.img}" alt="${data.text}" ${i < 2 ? 'fetchpriority="high" decoding="sync"' : 'loading="lazy" decoding="async"'}>
                    <span class="hero-slide-badge">${data.cat === 'Product' ? '🔬 Product' : '🏆 Milestone'}</span>
                    <span class="hero-slide-caption">${data.text}</span>`;
                heroStack.appendChild(div);
            });

            function updateStack() {
                heroStack.querySelectorAll('.hero-stack-image').forEach((card, i) => {
                    card.className = 'hero-stack-image';
                    const pos = (i - heroIdx + heroImages.length) % heroImages.length;
                    if (pos === 0) card.classList.add('active');
                    else if (pos === 1) card.classList.add('behind-1');
                    else if (pos === 2) card.classList.add('behind-2');
                    else if (pos === 3) card.classList.add('behind-3');
                    else card.classList.add('hidden');
                });
                // Mobile dots
                const dots = heroStack.querySelectorAll('.hero-dots .dot');
                dots.forEach((d, i) => d.classList.toggle('current', i === heroIdx));
            }

            // Mobile progress dots
            const dotsWrap = document.createElement('div');
            dotsWrap.className = 'hero-dots';
            dotsWrap.setAttribute('aria-hidden', 'true');
            heroImages.forEach((_, i) => {
                const dot = document.createElement('span');
                dot.className = 'dot' + (i === 0 ? ' current' : '');
                dotsWrap.appendChild(dot);
            });
            heroStack.appendChild(dotsWrap);

            updateStack(); // initial state

            // Autoplay (all viewports — starts immediately on load)
            let heroTimer = setInterval(() => { heroIdx = (heroIdx + 1) % heroImages.length; updateStack(); }, 3500);

            // Pause on interaction, resume after idle
            function pauseHero() { clearInterval(heroTimer); }
            function resumeHero() {
                clearInterval(heroTimer);
                heroTimer = setInterval(() => { heroIdx = (heroIdx + 1) % heroImages.length; updateStack(); }, 3500);
            }

            // Swipe support (mobile)
            let touchStartX = null, touchStartY = null;
            heroStack.addEventListener('touchstart', (e) => {
                touchStartX = e.touches[0].clientX;
                touchStartY = e.touches[0].clientY;
                pauseHero();
            }, { passive: true });
            heroStack.addEventListener('touchend', (e) => {
                if (touchStartX === null) return;
                const dx = e.changedTouches[0].clientX - touchStartX;
                const dy = e.changedTouches[0].clientY - touchStartY;
                if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
                    heroIdx = (heroIdx + (dx < 0 ? 1 : -1) + heroImages.length) % heroImages.length;
                    updateStack();
                }
                touchStartX = null;
                setTimeout(resumeHero, 4000);
            }, { passive: true });

            // Visibility: pause when tab hidden, resume when visible
            document.addEventListener('visibilitychange', () => {
                document.hidden ? pauseHero() : resumeHero();
            });

            // Slideshow Modal
            const modal = document.getElementById('slideshow-modal');
            const modalImg = document.getElementById('slideshow-image');
            const modalCap = document.getElementById('slideshow-caption');
            const dotsContainer = document.getElementById('slideshow-dots');
            let slideIdx = 0;

            // Create dots
            heroImages.forEach((_, i) => {
                const dot = document.createElement('div');
                dot.className = 'slideshow-dot' + (i === 0 ? ' active' : '');
                dot.addEventListener('click', () => { slideIdx = i; showSlide(); });
                dotsContainer.appendChild(dot);
            });

            function showSlide() {
                modalImg.src = heroImages[slideIdx].img;
                modalCap.innerHTML = `${heroImages[slideIdx].text} <span class="slideshow-cat">${heroImages[slideIdx].cat === 'Product' ? '🔬 Product' : '🏆 Milestone'}</span>`;
                dotsContainer.querySelectorAll('.slideshow-dot').forEach((d, i) => d.classList.toggle('active', i === slideIdx));
            }

            const heroVisual = document.getElementById('hero-visual');
            heroVisual.addEventListener('click', () => {
                openSlideshow();
            });
            heroVisual.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openSlideshow(); } });
            function openSlideshow() {
                slideIdx = heroIdx;
                showSlide();
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            document.getElementById('slideshow-close').addEventListener('click', () => { modal.classList.remove('active'); document.body.style.overflow = ''; });
            modal.addEventListener('click', (e) => { if (e.target === modal) { modal.classList.remove('active'); document.body.style.overflow = ''; }});
            document.getElementById('slideshow-prev').addEventListener('click', () => { slideIdx = (slideIdx - 1 + heroImages.length) % heroImages.length; showSlide(); });
            document.getElementById('slideshow-next').addEventListener('click', () => { slideIdx = (slideIdx + 1) % heroImages.length; showSlide(); });
            document.addEventListener('keydown', (e) => {
                if (!modal.classList.contains('active')) return;
                if (e.key === 'Escape') { modal.classList.remove('active'); document.body.style.overflow = ''; }
                if (e.key === 'ArrowLeft') { slideIdx = (slideIdx - 1 + heroImages.length) % heroImages.length; showSlide(); }
                if (e.key === 'ArrowRight') { slideIdx = (slideIdx + 1) % heroImages.length; showSlide(); }
            });

            // Load Data
            async function loadData() {
                try {
                    const jRes = await fetch('/journey.jsonl');
                    const jText = await jRes.text();
                    document.getElementById('journey-container').innerHTML = jText.trim().split('\n').map(JSON.parse).map(item => `
                        <div class="timeline-item"><div class="timeline-dot"></div><div class="timeline-date">${item.date}</div>
                        <div class="glass-card" style="padding: 1rem;"><h4 style="margin-bottom:0.25rem;">${item.event}</h4><p style="margin:0;font-size:0.85rem;">${item.details}</p></div></div>
                    `).join('');
                    // Staggered timeline reveal
                    const tItems = document.querySelectorAll('.timeline-item');
                    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                        const tio = new IntersectionObserver((entries) => {
                            entries.forEach(entry => {
                                if (entry.isIntersecting) {
                                    const el = entry.target;
                                    const idx = [...tItems].indexOf(el);
                                    el.style.transitionDelay = Math.min(idx * 0.08, 0.4) + 's';
                                    el.classList.add('revealed');
                                    tio.unobserve(el);
                                }
                            });
                        }, { threshold: 0.2 });
                        tItems.forEach(el => tio.observe(el));
                    } else {
                        tItems.forEach(el => el.classList.add('revealed'));
                    }

                    const tRes = await fetch('/team.jsonl');
                    const tText = await tRes.text();
                    const all = tText.trim().split('\n').map(JSON.parse);
                    
                    const team = all.filter(m => m.position !== "Advisor" && m.position !== "Past Member" && m.bio);
                    document.getElementById('team-container').innerHTML = team.map(m => `
                        <article class="glass-card team-card reveal reveal-scale" role="link" tabindex="0" aria-label="View profile of ${m.name}" onclick="window.location.href='/team/${m.id}'" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.location.href='/team/${m.id}'}">
                            <div class="team-img-wrapper">${m.image ? `<img src="${m.image}" alt="${m.name}" loading="lazy">` : `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2rem;color:var(--text-secondary);">${m.name.split(' ').map(n=>n[0]).join('')}</div>`}</div>
                            <h3>${m.name}</h3><div class="team-role">${m.position}</div>
                            <p class="team-bio">${m.bio.length > 80 ? m.bio.substring(0, 80) + '...' : m.bio}</p>
                        </article>
                    `).join('');

                    const advisors = all.filter(m => m.position === "Advisor");
                    document.getElementById('advisors-container').innerHTML = advisors.map(a => `
                        <article class="glass-card advisor-card reveal reveal-scale" role="link" tabindex="0" aria-label="View profile of ${a.name}" onclick="window.location.href='/team/${a.id}'" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.location.href='/team/${a.id}'}">
                            <div class="advisor-img-wrapper">${a.image ? `<img src="${a.image}" alt="${a.name}" loading="lazy">` : `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">${a.name.split(' ').map(n=>n[0]).join('')}</div>`}</div>
                            <h3>${a.name}</h3><div class="team-role">${a.position}</div>
                            <p class="team-bio">${a.bio.length > 100 ? a.bio.substring(0, 100) + '...' : a.bio}</p>
                        </article>
                    `).join('');
                } catch (e) { console.error(e); }
            }
            loadData().then(() => {
                // reveal for dynamically rendered cards
                const dyn = document.querySelectorAll('.team-card.reveal, .advisor-card.reveal');
                if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    const dio = new IntersectionObserver((entries) => {
                        entries.forEach(en => {
                            if (en.isIntersecting) { en.target.classList.add('revealed'); dio.unobserve(en.target); }
                        });
                    }, { threshold: 0.1 });
                    dyn.forEach(el => dio.observe(el));
                } else { dyn.forEach(el => el.classList.add('revealed')); }
            });

            // Products
            const products = [
                { name: 'Low-Bulk-Density Nanocellulose', cat: 'Nanocellulose', img: '/assets/images/products/crystalline_nano_cellulose_new.webp', desc: 'Next-generation plant-based nanocellulose.', portrait: false },
                { name: 'Microscope Immersion Oil Cleaning Kit', cat: 'Lab Essentials', img: '/assets/images/products/microscope_immersion_oil_kit.webp', desc: 'Optical-grade cellulose lens care.', portrait: true },
                { name: 'Marine & Industrial Oil Spill Kit', cat: 'Oil Spill Solution', img: '/assets/images/products/marine_oil_spill_kit_new.webp', desc: 'High-absorption, reusable spill cleanup.', portrait: false }
            ];
            document.getElementById('products-container').innerHTML = products.map(p => `
                <article class="product-card-modern" role="link" tabindex="0" aria-label="View ${p.name} details" onclick="window.location.href='/products'" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.location.href='/products'}">
                    <div class="product-image-wrapper">
                        <span class="product-category-tag">${p.cat}</span>
                        <img src="${p.img}" alt="${p.name}" class="${p.portrait ? 'portrait-showcase' : ''}" loading="lazy" decoding="async">
                    </div>
                    <div class="product-info">
                        <h3>${p.name}</h3>
                        <p>${p.desc}</p>
                        <span class="product-cta">View details <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
                    </div>
                </article>
            `).join('');


            // Scroll-reveal: sections/cards animate in as they enter viewport
            (function initReveal() {
                const els = document.querySelectorAll('.reveal');
                if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    els.forEach(el => el.classList.add('revealed'));
                    return;
                }
                const io = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('revealed');
                            io.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
                els.forEach(el => io.observe(el));
            })();

            // Contact — wired to Google Form (verified entry IDs)
            document.getElementById('contact-form').addEventListener('submit', async function(e) {
                e.preventDefault();
                const form = this;
                const status = document.getElementById('contact-status');
                const btn = form.querySelector('button[type="submit"]');
                const data = new FormData(form);
                status.textContent = 'Sending…'; status.style.color = 'var(--text-secondary)';
                btn.disabled = true;
                try {
                    const body = new URLSearchParams({
                        'entry.2005620554': data.get('name'),
                        'entry.1045781291': data.get('email'),
                        'entry.1065046570': 'RISE Foundation IISER, IISER Kolkata (from website contact form)',
                        'entry.514031641': data.get('subject'),
                        'entry.839337160': data.get('message')
                    });
                    await fetch('https://docs.google.com/forms/d/e/1FAIpQLSfZ84dsH5xsDtrnseAt47aQJiDD1bB8VYvBIPZ-zHz0eYlfPg/formResponse', {
                        method: 'POST', mode: 'no-cors', body
                    });
                    status.textContent = '✓ Message sent! We will get back to you soon.'; status.style.color = '#7ee787';
                    form.reset();
                } catch (err) {
                    status.textContent = 'Could not send — please email us directly.'; status.style.color = '#ff7b72';
                } finally { btn.disabled = false; }
            });
        });
    </script>
    <script is:inline>
    // Service Worker registration (PWA)
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch((e) => console.warn('SW registration failed:', e));
        });
    }
    </script>
</body>
</html>
