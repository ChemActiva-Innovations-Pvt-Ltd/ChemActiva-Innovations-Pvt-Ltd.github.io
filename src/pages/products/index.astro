---
/**
 * ChemActiva Products Page
 * Authored by Shuvam Banerji Seal
 */
import '../../styles/modern-design.css';

const title = "Products - ChemActiva Innovations";
const description = "Explore sustainable nanocellulose products including Greenulose™ and oil spill kits.";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="leaves-container" id="leaves-container"></div>

    <!-- Quote Modal -->
    <div class="modal-overlay" id="quote-modal">
        <div class="modal-content">
            <button class="modal-close" id="modal-close" aria-label="Close">&times;</button>
            <h2 style="margin-bottom: 0.75rem;">Request <span class="text-gradient">Quote</span></h2>
            <p style="color: var(--text-secondary); margin-bottom: 1rem; font-size: 0.9rem;">We'll respond within 24 hours.</p>
            <form class="contact-form" id="quote-form">
                <div class="form-group"><input type="text" name="name" placeholder="Your Name" required></div>
                <div class="form-group"><input type="email" name="email" placeholder="Your Email" required></div>
                <div class="form-group"><input type="text" name="product" id="quote-product" placeholder="Product" required></div>
                <div class="form-group"><textarea name="details" placeholder="Details (quantity, specifications, etc.)"></textarea></div>
                <button type="submit" class="btn-modern" style="width: 100%;">Submit</button>
            </form>
            <p id="quote-status" role="status" aria-live="polite" style="font-size: 0.85rem; margin-top: 0.75rem; text-align: center; min-height: 1.2em;"></p>
            <p style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.75rem; text-align: center;">
                Or fill our <a href="https://docs.google.com/forms/d/e/1FAIpQLSc_EAjG1Gjymylq5FFgervcxW8t1r0DkV_ONOPZOugHrEsL1A/viewform" target="_blank" rel="noopener noreferrer" style="color: var(--accent-secondary);">Quotation Form →</a>
            </p>
        </div>
    </div>

    <nav class="modern-navbar">
        <div class="container nav-container">
            <a href="/" class="nav-logo"><img src="/assets/images/logo.png" alt="ChemActiva"></a>
            <div class="nav-links-modern" id="nav-menu">
                <a href="/#our-journey">Journey</a>
                <a href="/#innovation">Innovation</a>
                <a href="/products" style="color: var(--accent-secondary);">Products</a>
                <a href="/blog">Blog</a>
                <a href="/#team">Team</a>
                <a href="/#contact">Contact</a>
                <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle dark/light theme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg></button>
            </div>
            <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
        </div>
    </nav>

    <main style="padding-top: 100px;">
        <section style="padding: 2rem 0; text-align: center;">
            <div class="container">
                <h1>Our <span class="text-gradient">Products</span></h1>
                <p style="color: var(--text-secondary); max-width: 500px; margin: 0 auto 1.5rem;">Sustainable solutions powered by nanocellulose.</p>
                <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
                    <span class="btn-outline product-badge" style="cursor: default; font-size: 0.8rem; padding: 0.5rem 1rem; display: inline-flex; align-items: center; gap: 0.4rem;"><img src="/assets/icons/leaf.svg" alt="" width="16" height="16" style="filter: none;"> Biodegradable</span>
                    <span class="btn-outline product-badge" style="cursor: default; font-size: 0.8rem; padding: 0.5rem 1rem; display: inline-flex; align-items: center; gap: 0.4rem;"><img src="/assets/icons/recycle.svg" alt="" width="16" height="16" style="filter: none;"> Circular Economy</span>
                    <span class="btn-outline product-badge" style="cursor: default; font-size: 0.8rem; padding: 0.5rem 1rem; display: inline-flex; align-items: center; gap: 0.4rem;"><img src="/assets/icons/microscope.svg" alt="" width="16" height="16" style="filter: none;"> Science-Driven</span>
                </div>
            </div>
        </section>

        <section style="padding: var(--section-padding);">
            <div class="container">
                <div id="products-grid" style="display: flex; flex-direction: column; gap: 2rem;"></div>
            </div>
        </section>

        <section style="padding: var(--section-padding); background: var(--bg-medium);">
            <div class="container" style="text-align: center;">
                <h2>Need a Custom Solution?</h2>
                <p style="margin-bottom: 1.5rem;">Contact us for bulk orders or specialized products.</p>
                <button class="btn-modern" onclick="openQuoteModal('Custom Solution')">Get in Touch</button>
            </div>
        </section>
        
        <footer class="footer-modern">
            <div class="container"><p>&copy; <span id="current-year"></span> ChemActiva Innovations. <a href="/blog">Blog</a></p></div>
        </footer>
    </main>

    <script is:inline>
        function openQuoteModal(product) {
            document.getElementById('quote-product').value = product;
            document.getElementById('quote-modal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Leaves (animated SVG, not emojis)
            const leavesContainer = document.getElementById('leaves-container');
            const LEAF_SVG = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21C7 16.5 4 13 4 9.5 4 6 6.5 3.5 10 3.5c1 0 2 .25 2 .25S13.5 3 15 3.5 20 6 20 9.5c0 3.5-3 7-8 11.5z" opacity="0.9"/><path d="M12 21c0-6 .5-10 3-14" opacity="0.5" stroke-width="1"/></svg>`;
            for (let i = 0; i < 10; i++) {
                const leaf = document.createElement('div');
                leaf.className = 'leaf-svg';
                leaf.setAttribute('aria-hidden', 'true');
                leaf.innerHTML = LEAF_SVG;
                leaf.style.left = Math.random() * 100 + '%';
                leaf.style.animationDelay = -(Math.random() * 14) + 's';
                leaf.style.animationDuration = (10 + Math.random() * 8) + 's';
                leaf.style.width = leaf.style.height = (18 + Math.random() * 18) + 'px';
                leavesContainer.appendChild(leaf);
            }

            // Modal
            document.getElementById('modal-close').addEventListener('click', () => { document.getElementById('quote-modal').classList.remove('active'); document.body.style.overflow = ''; });
            document.getElementById('quote-modal').addEventListener('click', (e) => { if (e.target.id === 'quote-modal') { document.getElementById('quote-modal').classList.remove('active'); document.body.style.overflow = ''; }});
            document.getElementById('quote-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                const form = e.target;
                const status = document.getElementById('quote-status');
                const btn = form.querySelector('button[type="submit"]');
                const data = new FormData(form);
                status.textContent = 'Submitting…'; status.style.color = 'var(--text-secondary)';
                btn.disabled = true;
                try {
                    // Google Forms quotation endpoint (verified entry IDs)
                    const body = new URLSearchParams({
                        'entry.1203149553': data.get('name'),
                        'entry.1879064070': data.get('email'),
                        'entry.788654624': data.get('product'),
                        'entry.1146899460': data.get('details') || '',
                        'entry.1882260475': `Quotation request for ${data.get('product')}`
                    });
                    await fetch('https://docs.google.com/forms/d/e/1FAIpQLSc_EAjG1Gjymylq5FFgervcxW8t1r0DkV_ONOPZOugHrEsL1A/formResponse', {
                        method: 'POST', mode: 'no-cors', body
                    });
                    status.textContent = '✓ Request submitted! We will respond within 24 hours.'; status.style.color = '#7ee787';
                    form.reset();
                    setTimeout(() => { document.getElementById('quote-modal').classList.remove('active'); document.body.style.overflow = ''; status.textContent = ''; }, 2500);
                } catch (err) {
                    status.textContent = 'Could not submit — please use the Quotation Form link below.'; status.style.color = '#ff7b72';
                } finally { btn.disabled = false; }
            });

            // Hamburger
            const hamburger = document.getElementById('hamburger');
            const navMenu = document.getElementById('nav-menu');
            hamburger.addEventListener('click', () => { hamburger.classList.toggle('active'); navMenu.classList.toggle('active'); });
            navMenu.querySelectorAll('a').forEach(l => l.addEventListener('click', () => { hamburger.classList.remove('active'); navMenu.classList.remove('active'); }));

            // Theme
            const themeBtn = document.getElementById('theme-toggle');
            if (localStorage.getItem('theme') === 'light') { document.body.classList.add('light-mode'); themeBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>'; }
            themeBtn.addEventListener('click', () => { document.body.classList.toggle('light-mode'); const isLight = document.body.classList.contains('light-mode'); themeBtn.innerHTML = isLight ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>' : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>'; themeBtn.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme'); localStorage.setItem('theme', isLight ? 'light' : 'dark'); });

            document.getElementById('current-year').textContent = new Date().getFullYear();

            // Products — Green-Tech Valorization of Indigenous Shola Plant
            const products = [
                {
                    id: 'lbdn',
                    name: 'Low-Bulk-Density Nanocellulose',
                    tagline: 'Next-Generation | Plant-Based | Lightweight',
                    desc: 'A next-generation, plant-based nanocellulose material offering low bulk density, high functionality, and environmental sustainability for lightweight and high-performance applications.',
                    cat: 'Nanocellulose',
                    images: ['/assets/images/products/crystalline_nano_cellulose_new.webp', '/assets/images/products/Crystalline_Nano_Cellulose_50gm.webp', '/assets/images/products/Greenulose_25g_bottle.webp', '/assets/images/products/Greenulose_100g_bottle.webp'],
                    features: ['Low Bulk Density', 'Plant-Based', 'High Performance']
                },
                {
                    id: 'miok',
                    name: 'Microscope Immersion Oil Cleaning Kit',
                    tagline: 'Specialized | Optical-Grade | Lens-Safe',
                    desc: 'A specialized cellulose-based solution designed to efficiently remove immersion oil from the objective lenses of automated digital and conventional microscopes while helping protect sensitive optical surfaces.',
                    cat: 'Lab Essentials',
                    images: ['/assets/images/products/microscope_immersion_oil_kit.webp'],
                    features: ['Optical-Grade', 'Lens Protection', 'Efficient Cleaning']
                },
                {
                    id: 'mosk',
                    name: 'Marine & Industrial Oil Spill Kit',
                    tagline: 'High Absorption | Reusable | Eco-Safe',
                    desc: 'A cellulose-based oil-absorbent solution designed for the rapid and effective cleanup of oil spills in industrial, marine, and coastal environments, offering high absorption capacity, reusability, and reduced secondary pollution.',
                    cat: 'Oil Spill Solution',
                    images: ['/assets/images/products/marine_oil_spill_kit_new.webp', '/assets/images/products/domestic_oil_spill_kit_new.webp', '/assets/images/products/Domestic_oil_spill_kit_1.webp'],
                    features: ['High Absorption', 'Reusable', 'Reduced Secondary Pollution']
                }
            ];

            const grid = document.getElementById('products-grid');
            grid.innerHTML = products.map((p, idx) => {
                const rev = idx % 2 === 1;
                const mainDims = p.id === 'miok' ? 'width="394" height="652"' : 'width="1200" height="900"';
                return `
                <article class="glass-card product-detail-grid">
                    <div class="product-gallery" style="order: ${rev ? 2 : 1};">
                        <img class="product-main-image" id="main-${p.id}" src="${p.images[0]}" alt="${p.name}" ${mainDims} ${idx === 0 ? 'fetchpriority="high" decoding="sync"' : 'loading="lazy" decoding="async"'}>
                        <div class="product-thumbnails">
                            ${p.images.map((img, i) => `<img src="${img}" alt="View ${i+1}" width="120" height="90" class="product-thumb ${i === 0 ? 'active' : ''}" loading="lazy" decoding="async" onclick="document.getElementById('main-${p.id}').src='${img}'; this.parentElement.querySelectorAll('.product-thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');">`).join('')}
                        </div>
                    </div>
                    <div class="product-details" style="order: ${rev ? 1 : 2};">
                        <span class="product-category-tag">${p.cat}</span>
                        <h2>${p.name}</h2>
                        <p class="product-tagline">${p.tagline}</p>
                        <p style="line-height: 1.6; margin-bottom: 1rem;">${p.desc}</p>
                        <div class="product-features">${p.features.map(f => `<span class="product-feature-tag">${f}</span>`).join('')}</div>
                        <button class="btn-modern" onclick="openQuoteModal('${p.name}')">Request Quote</button>
                    </div>
                </article>
                `;
            }).join('');
        });
    </script>
</body>
</html>
